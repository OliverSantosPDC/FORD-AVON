# FORD-AVON · Variables de entorno del frontend (Vite)
# Copia este archivo a .env.local (desarrollo) y configúralas en Vercel (producción).

# Supabase (proyecto)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL base del backend (Render u otro). Vacío = mismo origen.
VITE_API_URL=

# URL pública de la app; usada para el redirectTo de recuperación de contraseña.
# En local: http://localhost:5173  ·  En Vercel: https://<tu-dominio>.vercel.app
# Si se deja vacío, se usa window.location.origin en tiempo de ejecución.
VITE_APP_URL=

# Storage de cartera (opcionales; tienen valores por defecto)
VITE_SUPABASE_CARTERA_BUCKET=cartera
VITE_SUPABASE_CARTERA_OBJECT=CARTERA COBRO.xlsx
